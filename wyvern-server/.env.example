# Wyvern Server Environment Variables

# Database Configuration
# For local development (SQLite): leave DATABASE_URL empty
# For production (Supabase/Postgres): set DATABASE_URL
# DATABASE_URL=postgresql://user:password@host:5432/database

# SQLite path (optional, defaults to ../wyvern.db)
# SQLITE_PATH=./wyvern.db

# Server port (optional)
PORT=8080
