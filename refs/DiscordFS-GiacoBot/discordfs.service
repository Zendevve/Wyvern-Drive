[Unit]
Description=DiscordFS - Cloud storage backed by Discord
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=%h/.config/discordfs/.env
ExecStart=%h/.local/share/discordfs/.venv/bin/discordfs mount --foreground
ExecStop=/usr/bin/fusermount -u %h/DiscordFS
Restart=on-failure
RestartSec=10

# Security hardening
UMask=0077

[Install]
WantedBy=default.target
