# Wyvern Drive server — environment configuration
# Copy to .env (or set in the process environment) and fill in real values.
# Every variable below is REQUIRED unless marked "(optional)".
#
# The server loads this file automatically (dotenv) on `npm start`, so the
# documented `Copy-Item .env.example .env` flow just works. If any required
# value is missing or invalid, the server boots into read-only SETUP MODE:
# it serves GET /api/setup/status and the guided /setup page listing exactly
# which variables are missing (never their values). Fill everything in and
# restart. The only fatal configuration error is an invalid PORT.
#
# IMPORTANT: Wyvern does NOT run a Discord bot. Identity is Discord OAuth2 and
# storage is one per-user Discord webhook: each authenticated user pastes their
# own webhook URL on the /connect page, and the server encrypts it at rest.
# No global webhook variable exists — the webhook is a per-user credential.

# Runtime mode: development | test | production
# production turns on Secure cookies. In test mode .env is not loaded; the
# test suite sets every variable explicitly.
NODE_ENV=development

# TCP port the server listens on. 0 picks an ephemeral port (tests/CI).
PORT=8080

# Public origin of the web client. Used for OAuth redirects, CORS, CSRF
# Origin checks, and share URLs. Must be a plain http(s) URL with no path.
APP_ORIGIN=http://localhost:3000

# SQLite database location. Use a file path in production (e.g. ./data/wyvern.db);
# the parent directory is created automatically on startup. ":memory:" is for
# tests only.
DB_URL=./data/wyvern.db

# Discord OAuth2 application (https://discord.com/developers/applications):
# Application -> OAuth2 -> Client ID / Client Secret.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Redirect URI registered on the Discord application. Must be an absolute
# http(s) URL and must match the registered redirect EXACTLY.
DISCORD_REDIRECT_URI=http://localhost:3000/api/auth/discord/callback

# Master AES-256-GCM key: base64 of EXACTLY 32 bytes. Never share it; the
# server uses it to encrypt/decrypt every file chunk AND every user's webhook
# credential at rest.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
WYVERN_ENCRYPTION_KEY=

# Per-user storage quota in bytes (default 10737418240 = 10 GiB).
DEFAULT_QUOTA_BYTES=10737418240

# (optional, test-only) Upload chunk size in bytes. Only honored when
# NODE_ENV=test; ignored otherwise. Production always uses 24 MiB so the
# encrypted attachment stays under Discord's 25 MiB free upload limit.
WYVERN_CHUNK_SIZE_BYTES=8
